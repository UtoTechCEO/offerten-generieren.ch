---
import "../styles/global.css";
import OfferForm from "../components/OfferForm";
---

<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Offerte generieren | offerte-generieren.ch</title>
  </head>
  <body>
    <header class="border-b">
      <div class="container py-4">
        <a href="/" class="font-bold">offerte‑generieren.ch</a>
      </div>
    </header>

    <main class="container">
      <section class="py-8">
        <div class="card">
          <h1 class="text-2xl font-semibold">Offerte generieren</h1>
          <p class="text-sm text-gray-600 mt-1">Gib unten die Details ein. Die PDF wird anschliessend erstellt.</p>
          <div class="mt-6">
            <OfferForm client:load />
          </div>
        </div>
      </section>
    </main>
  </body>
</html>

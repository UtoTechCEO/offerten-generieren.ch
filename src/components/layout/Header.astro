---
const navigation = [
  { label: "Workspace", href: "/#generator" },
  { label: "Offerten", href: "/#generator", tab: "offers" },
  { label: "Rechnungen", href: "/#generator", tab: "invoices" },
];
---

<header class="gx-header">
  <div class="gx-header-glow" aria-hidden="true"></div>
  <div class="gx-header-inner">
    <a class="gx-brand" href="/" aria-label="generatix – Startseite">
      <span class="gx-mark" aria-hidden="true">
        <svg viewBox="0 0 40 40" fill="none" width="27" height="27">
          <path d="M10 10h12l8 8v12H10V10Z" stroke="currentColor" stroke-width="1.65" stroke-linejoin="round" />
          <path d="M22 10v8h8M15 23h11M15 27h8" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" />
          <path d="M6 7h5M8.5 4.5v5" stroke="#8ceaf9" stroke-width="1.4" stroke-linecap="round" />
        </svg>
      </span>
      <span class="gx-brand-stack">
        <span class="gx-brand-name">genera<span>tix</span><b>.</b></span>
        <span class="gx-brand-sub">DOCUMENT INTELLIGENCE</span>
      </span>
    </a>

    <nav class="gx-header-links" aria-label="Hauptnavigation">
      {navigation.map((item) => (
        <a href={item.href} data-header-tab={item.tab}>{item.label}</a>
      ))}
    </nav>

    <a class="gx-header-cta" href="/#generator">
      <span class="gx-cta-spark" aria-hidden="true">✧</span>
      Generator öffnen
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLAnchorElement>("[data-header-tab]").forEach((anchor) => {
    anchor.addEventListener("click", () => {
      const tab = anchor.dataset.headerTab;
      if (!tab) return;
      document.querySelector<HTMLButtonElement>(`[data-tab="${tab}"]`)?.click();
    });
  });
</script>

<style>
  .gx-header {
    position: relative;
    z-index: 40;
    isolation: isolate;
    overflow: hidden;
    background: linear-gradient(110deg, #0b101df0 0%, #131527ef 50%, #0d1625f0 100%);
    border-bottom: 1px solid rgba(218, 240, 255, .19);
    box-shadow: inset 0 1px rgba(255, 255, 255, .1), 0 14px 48px rgba(0, 0, 0, .13);
    backdrop-filter: blur(36px) saturate(155%);
    -webkit-backdrop-filter: blur(36px) saturate(155%);
  }
  .gx-header::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(181, 234, 255, .62) 33%, rgba(203, 177, 255, .53) 70%, transparent);
    pointer-events: none;
  }
  .gx-header-glow {
    position: absolute;
    z-index: -1;
    top: -105px;
    right: 17%;
    width: 400px;
    height: 180px;
    background: radial-gradient(ellipse, rgba(167, 143, 246, .21), transparent 68%);
    pointer-events: none;
  }
  .gx-header-inner {
    width: min(calc(100% - 48px), 1240px);
    margin: auto;
    min-height: 81px;
    display: flex;
    align-items: center;
    gap: 30px;
  }
  .gx-brand { display: inline-flex; gap: 12px; align-items: center; white-space: nowrap; text-decoration: none; }
  .gx-mark {
    display: grid;
    place-items: center;
    width: 45px;
    height: 45px;
    color: #f3f6ff;
    flex: none;
    border: 1px solid rgba(233, 248, 255, .52);
    border-radius: 14px;
    background: linear-gradient(145deg, rgba(226, 245, 255, .3), rgba(169, 179, 250, .13) 46%, rgba(159, 232, 249, .09));
    box-shadow: inset 0 1px rgba(255, 255, 255, .57), inset 0 -10px 18px rgba(74, 109, 150, .15), 0 10px 24px rgba(0, 0, 0, .24), 0 0 19px rgba(143, 223, 245, .11);
    transform: translateZ(0);
  }
  .gx-brand-stack { display: grid; gap: 1px; }
  .gx-brand-name {
    font: 780 1.32rem/1.02 Inter, ui-sans-serif, system-ui, sans-serif;
    letter-spacing: -.067em;
    color: #f5f8ff;
  }
  .gx-brand-name span { color: #d3dce9; }
  .gx-brand-name b { color: #99f0fc; }
  .gx-brand-sub { font: 750 .47rem/1.4 Inter, ui-sans-serif, system-ui, sans-serif; letter-spacing: .19em; color: #92a6bb; }
  .gx-header-links { display: flex; align-items: center; justify-content: center; gap: 31px; margin: 0 auto; }
  .gx-header-links a {
    text-decoration: none;
    font-size: .81rem;
    font-weight: 630;
    color: #adbad1;
    transition: color .2s ease, text-shadow .2s ease;
  }
  .gx-header-links a:hover, .gx-header-links a:focus-visible { color: #eafaff; text-shadow: 0 0 20px rgba(148, 231, 254, .44); }
  .gx-header-cta {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    padding: 12px 18px;
    color: #f4f8ff;
    font-weight: 750;
    font-size: .79rem;
    white-space: nowrap;
    text-decoration: none;
    border: 1px solid rgba(222, 241, 255, .39);
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(222, 239, 254, .23), rgba(210, 211, 255, .075));
    box-shadow: inset 0 1px rgba(255,255,255,.38), 0 7px 22px rgba(0,0,0,.19);
    backdrop-filter: blur(26px);
    transition: background .2s, transform .2s, box-shadow .2s;
  }
  .gx-header-cta:hover { background: rgba(217, 238, 255, .22); transform: translateY(-2px); box-shadow: 0 9px 30px rgba(139, 221, 246, .12); }
  .gx-header-cta > span:last-child, .gx-cta-spark { color: #9ceaf8; }
  @media (max-width: 820px) {
    .gx-header-inner { gap: 16px; }
    .gx-header-links { gap: 16px; }
    .gx-header-cta { display: none; }
  }
  @media (max-width: 540px) {
    .gx-header-inner { width: calc(100% - 28px); min-height: 70px; }
    .gx-mark { width: 37px; height: 37px; border-radius: 11px; }
    .gx-mark svg { width: 23px; height: 23px; }
    .gx-brand-name { font-size: 1.13rem; }
    .gx-brand-sub { font-size: .41rem; }
    .gx-header-links { gap: 12px; }
    .gx-header-links a { font-size: .7rem; }
    .gx-header-links a:nth-child(n+2) { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .gx-header * { transition-duration: .01ms !important; } }
</style>

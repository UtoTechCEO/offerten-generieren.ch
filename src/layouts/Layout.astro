
---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Offerten & Rechnungen | offerten-generieren.ch",
  description = "Offerten und Rechnungen einfach erstellen und als PDF herunterladen.",
} = Astro.props;
---

<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    font-family: Inter, ui-sans-serif, system-ui,
      -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
  }

  body {
    margin: 0;
    min-width: 320px;
    background: #ffffff;
    color: #233848;
  }

  button,
  input,
  textarea,
  select {
    font: inherit;
  }
</style>
